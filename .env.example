PORT=8787
APP_ORIGIN=*

ANYTHINGLLM_BASE_URL=http://localhost:3001/api
ANYTHINGLLM_API_KEY=replace-with-your-anythingllm-api-key
ANYTHINGLLM_WORKSPACE_SLUG=my-workspace

# Optional: send OTP messages through your own email/Gmail service webhook.
# The backend posts: { to, subject, text }
EMAIL_WEBHOOK_URL=

# Optional: send OTP messages through your SMS provider webhook.
# The backend posts: { to, text }
SMS_WEBHOOK_URL=

# Optional: OAuth sign-in redirect URLs generated by your auth provider.
GOOGLE_AUTH_URL=
GITHUB_AUTH_URL=

# MongoDB Atlas driver connection. Keep the password in your local .env only.
# Example cluster host: mongodb+srv://<username>:<password>@cluster0.7gyqkql.mongodb.net/rook_ai?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=rook_ai
MONGODB_USERS_COLLECTION=users
MONGODB_PROFILES_COLLECTION=profiles
MONGODB_OTP_COLLECTION=otp_events
MONGODB_EVENTS_COLLECTION=user_events

# Optional fallback: MongoDB Atlas Data API for login capture.
MONGODB_DATA_API_URL=https://data.mongodb-api.com/app/YOUR_APP_ID/endpoint/data/v1
MONGODB_DATA_API_KEY=
MONGODB_DATA_SOURCE=Cluster0

# Optional: Nano Banana image generation through Gemini API.
# Nano Banana: gemini-2.5-flash-image
# Nano Banana Pro: gemini-3-pro-image-preview
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-1.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional: direct local Ollama for general chat when Gemini is not configured.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERAL_MODEL=qwen2.5:0.5b
